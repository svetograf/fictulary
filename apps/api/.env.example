PORT=3333

DB_HOST=localhost
DB_PORT=5432
DB_USER=fictulary
DB_PASSWORD=fictulary
DB_NAME=fictulary
# Apply pending migrations on startup. Otherwise run `npx nx run api:migration-run`.
DB_MIGRATIONS_RUN=true
DB_LOGGING=false

# Secret used to sign auth tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
