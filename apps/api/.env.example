PORT=3333

DB_HOST=localhost
DB_PORT=5432
DB_USER=fictulary
DB_PASSWORD=fictulary
DB_NAME=fictulary
# Apply pending migrations on startup. Otherwise run `npx nx run api:migration-run`.
DB_MIGRATIONS_RUN=true
DB_LOGGING=false

# Secret used to sign auth tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Google OAuth client ids. The web client needs <web origin>/auth/callback as
# an authorized redirect URI. The iOS one is optional until the iOS app exists.
GOOGLE_WEB_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=

# Sign in with Apple: optional. Leave all of these unset to turn Apple off
# (the sign-in page then hides its button); set all of them to turn it on.
# The private key is the .p8 file's contents; on one line, write newlines
# as \n.
# APPLE_TEAM_ID=ABCDE12345
# APPLE_KEY_ID=FGHIJ67890
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_BUNDLE_ID=com.example.fictulary
# APPLE_SERVICES_ID=com.example.fictulary.web
# APPLE_REDIRECT_URI=https://app.example.com/auth/callback

# Required with Apple: encrypts the Apple tokens stored in the database
# (32 bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_ENCRYPTION_KEY=change-me

# Local development only: enables POST /api/auth/dev { email, name? }, which
# signs in as any email without a provider. Refused when NODE_ENV=production and
# from non-local addresses.
AUTH_DEV_LOGIN=false
